// ===========================================
// MISSEDCALL AI - DATABASE SCHEMA
// ===========================================
// This defines all your database tables and relationships
// Run `npm run db:push` to sync this to your database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================
// BUSINESS - Your customers (dentists, salons, etc.)
// ===========================================
model Business {
  id String @id @default(cuid())

  // Basic info
  name         String // "Smith Dental"
  slug         String  @unique // "smith-dental" (for URLs)
  businessType String? // Landscaping, Car Detailing, HVAC, Other
  ownerGroupId String? // Businesses sharing a non-null value form an owner group (aggregated Website Leads + Google Ads). null = no group, behavior unchanged

  // Telnyx phone number provisioned for this business
  telnyxPhoneNumber        String? @unique
  forwardingNumber         String? // Owner's real phone number to ring first
  notificationSenderNumber String? // Shared fallback FROM for owner notification SMS. No @unique on purpose: many businesses may share one number.

  // Business details
  timezone        String @default("America/New_York")
  businessHours   Json? // { monday: { open: "09:00", close: "17:00" }, ... }
  servicesOffered Json? // ["cleaning", "filling", "crown", ...]

  // AI customization
  aiGreeting     String? // Custom first message
  aiInstructions String? @db.Text // Custom personality/rules for the AI
  aiContext      String? @db.Text // Business context (what they do, policies, etc.)

  // Calendar integration (optional per business)
  calendarEnabled         Boolean @default(false)
  googleAccessToken       String? @db.Text
  googleRefreshToken      String? @db.Text
  googleCalendarConnected Boolean @default(false)
  slotDurationMinutes     Int     @default(30) // Booking slot length (15, 30, 45, etc.)
  bufferMinutes           Int     @default(0) // Buffer between back-to-back appointments
  smsBookingEnabled       Boolean @default(true) // When false, SMS AI captures leads instead of booking even if calendar is connected

  // Billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String  @default("trialing") // trialing, active, past_due, canceled

  // Google Ads integration
  googleAdsCustomerId String? // Google Ads customer ID (no dashes, e.g. "1234567890")
  googleAdsEnabled    Boolean @default(false) // Show Google Ads tab in dashboard
  googleAdsTabLabel   String? @default("Google Ads") // Custom label for the ads nav item

  // Admin tracking
  adminNotes                   String? @db.Text // Private notes only Jacob sees
  setupFee                     Float? // What they paid upfront
  monthlyFee                   Float? // What they pay monthly
  spamFilterEnabled            Boolean @default(false) // Premium feature - spam call filtering
  callScreenerEnabled          Boolean @default(false)
  callScreenerMessage          String?
  missedCallVoiceMessage       String? @default("We're sorry we can't get to the phone right now. You should receive a text message shortly.")
  missedCallAiEnabled          Boolean @default(true) // Send AI SMS after missed call
  knownContactVoicemailEnabled Boolean @default(false) // When on, missed calls from the client's own contacts (isClientContact) go to voicemail instead of AI SMS
  noReplyAlertEnabled          Boolean @default(false) // Alert owner when a missed-call text-back gets no reply within noReplyAlertMinutes
  noReplyAlertMinutes          Int     @default(60) // Minutes to wait for a customer reply before alerting the owner
  smsCooldownDays              Int? // Cooldown period in days (null = use env SMS_COOLDOWN_DAYS or default 7)
  cooldownBypassNumbers        Json?   @default("[]") // Admin: phone numbers that skip cooldown (for testing)

  // Booking page customization (per-business labels)
  bookingPageTitle            String? // e.g. "Schedule a Free In-Person Quote"
  bookingPageServiceLabel     String? // e.g. "What do you need a quote for?"
  bookingPageConfirmation     String? @db.Text // e.g. "You're all set! Someone from {businessName} will meet you at your scheduled time."
  bookingPageHeaderTagline    String? // Override header bar text (default: bookingPageTitle or "Schedule a Free In-Person Quote")
  bookingPageSubtitle         String? // Override subtitle under the H1 (default: "Select a date and time for your in-person quote visit")
  bookingPageDateLabel        String? // Override label above calendar (default: "Select a date for your quote visit")
  bookingPageNotesLabel       String? // Override notes field label (default: "Tell us about the job so we can prepare")
  bookingPageNotesPlaceholder String? // Override notes placeholder (default: "Yard size, specific areas, access details, etc.")
  bookingHideAddress          Boolean @default(false) // true = do not render the address field at all (bookingRequiresAddress only controls required-ness)
  bookingConfirmationSmsText  String? @db.Text // Override website-booking confirmation SMS. Placeholders: {businessName}, {date}, {time}, {service}
  bookingRequiresAddress      Boolean @default(true) // Require property address when booking (turn off for businesses that don't need it)
  maxMessagesPerConversation  Int     @default(23) // Stop responding after this many messages (configurable per business)

  // Owner notification preferences (booking created/cancelled)
  ownerEmail           String? // Business owner email for notifications
  ownerPhone           String? // Owner's phone for SMS (falls back to forwardingNumber)
  notifyBySms          Boolean @default(true) // Send SMS to owner on booking events
  notifyByEmail        Boolean @default(true) // Send email to owner on booking events
  massMessagingEnabled Boolean @default(false) // Unlock email + SMS campaign outreach features

  // QuickBooks / Intuit OAuth (see lib/quickbooks.ts)
  quickbooksConnected     Boolean   @default(false)
  qbRealmId               String? // Intuit company id — arrives ONLY as a callback query param, cannot be recovered later
  qbAccessToken           String?   @db.Text
  qbRefreshToken          String?   @db.Text
  qbAccessTokenExpiresAt  DateTime?
  qbRefreshTokenExpiresAt DateTime? // QBO expires an idle refresh token after 100 days
  qbLastRefreshError      String?   @db.Text

  // Review request automation (see lib/quickbooks.ts, ReviewRequest)
  reviewRequestsEnabled Boolean @default(false)
  reviewTrigger         String  @default("payment_received") // payment_received, invoice_sent, invoice_created
  reviewDelayMinutes    Int     @default(120)
  reviewQuietStartHour  Int     @default(9) // business-local hour, inclusive
  reviewQuietEndHour    Int     @default(20) // business-local hour, exclusive
  reviewCapDays         Int     @default(90)
  googleReviewLink      String?
  reviewMessageTemplate String? @db.Text
  billingWebhookSecret  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  users              User[]
  conversations      Conversation[]
  appointments       Appointment[]
  screenedCalls      ScreenedCall[]
  blockedNumbers     BlockedNumber[]
  contacts           Contact[]
  contactCooldowns   ContactCooldown[]
  cooldownSkipLogs   CooldownSkipLog[]
  telnyxUsageRecords TelnyxUsageRecord[]
  tags               Tag[]
  jobs               Job[]
  emailCampaigns     EmailCampaign[]
  activities         Activity[]
  websiteLeads       WebsiteLead[]
  googleAdsSnapshots GoogleAdsSnapshot[]
  reviewRequests     ReviewRequest[]

  @@index([stripeCustomerId])
  @@index([ownerGroupId])
  // NOT unique: one QBO company can legitimately map to several Business rows
  // (an owner running multiple businesses out of one QuickBooks file).
  @@index([qbRealmId])
}

// ===========================================
// TELNYX USAGE RECORD - Cached MDR/CDR cost data per business
// Stores actual Telnyx charges from Detail Record Search API
// ===========================================
model TelnyxUsageRecord {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  recordType     String // "sms" | "call"
  telnyxRecordId String @unique // Telnyx MDR uuid or CDR id
  cost           Float  @default(0) // USD amount charged by Telnyx

  occurredAt DateTime
  metadata   Json? // { durationSeconds?, from?, to?, direction?, ... }

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, recordType])
  @@index([occurredAt])
}

// ===========================================
// CONTACT - Client's address book; skip automated SMS to existing contacts
// Numbers here are people the business already knows (no wasted texts)
// ===========================================
model Contact {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber String // Stored in normalized form for matching
  name        String?
  createdAt   DateTime @default(now())

  // Optional CRM fields
  email           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  source          String? // missed_call, website_form, manual, referral, google_ad
  isClientContact Boolean   @default(false) // True = client's own saved contact (their customer list / future voicemail list). Written & displayed only; NOT read during call routing.
  status          String?   @default("new") // new, contacted, quoted, booked, completed, lost
  notes           String?   @db.Text
  lastContactedAt DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
  totalRevenue    Float?    @default(0)

  // Reverse relations for new models
  contactTags     ContactTag[]
  jobs            Job[]
  emailRecipients EmailRecipient[]
  activities      Activity[]
  reviewRequests  ReviewRequest[]

  @@unique([businessId, phoneNumber])
  @@index([businessId])
}

// ===========================================
// BLOCKED NUMBER - Numbers that don't get MissedCall AI SMS
// ===========================================
model BlockedNumber {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber String
  label       String?
  createdAt   DateTime @default(now())

  @@unique([businessId, phoneNumber])
  @@index([businessId])
}

// ===========================================
// USER - People who log into the dashboard
// ===========================================
model User {
  id String @id @default(cuid())

  // Clerk integration
  clerkId String @unique // Clerk's user ID

  // User info (synced from Clerk)
  email     String
  firstName String?
  lastName  String?
  imageUrl  String?

  // Role within the business
  role String @default("owner") // owner, admin, staff

  // Which business they belong to
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([businessId])
}

// ===========================================
// CONVERSATION - Each missed call = one conversation
// ===========================================
model Conversation {
  id String @id @default(cuid())

  // Which business this belongs to
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Caller info
  callerPhone       String // +1234567890
  callerName        String? // Gathered during conversation
  callSid           String? @unique // Call control ID (parent voice call)
  aLegCallControlId String? // A-leg call_control_id stored when forwarding
  callConnected     Boolean @default(false) // True when B-leg (owner) answered — prevents missed-call SMS

  // Dial outcome (from voice-dial-status callback)
  dialCallStatus  String? // completed, no-answer, busy, failed, canceled
  answeredBy      String? // human, machine, fax, unknown
  durationSeconds Int? // Dial leg duration in seconds
  callEndedAt     DateTime? // When the dial attempt ended

  // Voicemail (spam-screening-only flow when missedCallAiEnabled is false)
  recordingUrl           String? // URL of voicemail recording (mp3)
  voicemailTranscription String? @db.Text // Transcription of voicemail (from Telnyx)

  // Conversation state
  status     String  @default("active") // active, booking_in_progress, appointment_booked, closed, human_needed, completed, no_response, screening
  manualMode Boolean @default(false) // When true, inbound messages do NOT trigger AI; owner handles manually via dashboard

  // AI-generated summary of the conversation
  summary String? @db.Text

  // SMS booking flow state: { step, slotsSent?, selectedSlot?, ... }
  bookingFlowState Json?

  // What the caller needed (extracted by AI)
  intent           String? // "book_appointment", "question", "emergency", etc.
  serviceRequested String? // "teeth cleaning", "oil change", etc.

  // Lead capture fields (calendar-disabled flow)
  customerEmail     String?
  customerAddress   String? @db.Text
  customerTimeframe String? // "this week", "next week", "no rush", etc.

  // No-reply owner alert (cron): set once when the owner has been alerted that the
  // customer never replied to the missed-call text-back. Null = not alerted.
  noReplyAlertSentAt DateTime?

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  // Relationships
  messages    Message[]
  appointment Appointment?

  @@index([businessId])
  @@index([callerPhone])
  @@index([status])
  @@index([createdAt])
}

// ===========================================
// MESSAGE - Individual texts in a conversation
// ===========================================
model Message {
  id String @id @default(cuid())

  // Which conversation this belongs to
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Message details
  direction String // "inbound" (from caller) or "outbound" (from AI)
  content   String @db.Text // The actual message text

  // Telnyx tracking
  telnyxSid    String? // Telnyx message ID for tracking
  telnyxStatus String? // sent, delivered, failed, etc.
  cost         Float? // Actual cost from Telnyx MDR (USD)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ===========================================
// APPOINTMENT - When AI successfully books
// ===========================================
model Appointment {
  id String @id @default(cuid())

  // Relationships
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversationId String?       @unique // Null for web bookings
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Customer info
  customerName  String
  customerPhone String
  customerEmail String?

  // Appointment details
  serviceType     String // "teeth cleaning", "haircut", etc.
  scheduledAt     DateTime // When the appointment is
  duration        Int      @default(60) // Duration in minutes
  notes           String?  @db.Text // Any special notes/requests
  customerAddress String?  @db.Text // Address for the quote visit

  // Source tracking (website vs sms)
  source String @default("website") // "website" | "sms"

  // Calendar integration
  googleCalendarEventId String?
  calendarSyncFailed    Boolean @default(false) // True when we saved to DB but calendar sync failed

  // Status tracking
  status String @default("confirmed") // confirmed, cancelled, completed, no_show

  // Reminders
  reminderSentAt DateTime? // legacy, unused — nothing writes it

  // Marketing funnel (/book) demo-call reminders. Separate nullable timestamps
  // so each reminder is independently idempotent: the cron claims one by
  // conditionally setting its column, then sends.
  // Google Meet link for the booking, from conferenceData on event insert.
  // Needs a real column because the reminder SMS reads it back at send time.
  googleMeetLink String?

  // A/B arm this booking came from: "gate" | "nogate" | null for pre-test rows.
  variant String?

  // Funnel VIDEO A/B: "A" | "B". Separate from `variant` for the same reason.
  funnelVariant String?

  /// Same first/last touch pair as WebsiteLead, stamped at confirm. Kept on the
  /// booking too, not just the lead, because a booking can happen with no lead
  /// row at all — the landing calendar takes people who never hit the gate.
  attributionFirst Json?
  attributionLast  Json?

  /// "landing" | "watch" | "calendar". Finer than `source`, which only knows
  /// website / sms_link / direct.
  bookingSurface String?

  reminderNightBeforeSentAt DateTime?
  reminderHourBeforeSentAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([scheduledAt])
  @@index([status])
}

// ===========================================
// PHONE NUMBER POOL - Available Telnyx numbers
// ===========================================
model PhoneNumber {
  id String @id @default(cuid())

  phoneNumber String @unique // +1234567890
  telnyxSid   String @unique // Telnyx phone number SID

  // Assignment
  assignedToBusinessId String? // Which business is using this (null = available)

  // Status
  status String @default("available") // available, assigned, released

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ===========================================
// CONTACT COOLDOWN - Tracks last automated message per phone number
// Used to enforce SMS cooldown (e.g. don't send to same number within 7 days)
// ===========================================
model ContactCooldown {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber     String
  lastMessageSent DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([phoneNumber])
}

// ===========================================
// COOLDOWN SKIP LOG - Tracks when messages are skipped due to cooldown
// For analytics / cost savings reporting
// ===========================================
model CooldownSkipLog {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber     String
  reason          String   @default("cooldown")
  attemptedAt     DateTime @default(now())
  lastMessageSent DateTime
  messageType     String? // "missed_call", "ai_followup", etc.

  @@index([businessId])
  @@index([attemptedAt])
}

// ===========================================
// SCREENED CALL - Call screening / spam filter
// ===========================================
model ScreenedCall {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callerPhone String
  callSid     String?
  result      String   @default("blocked")
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([businessId, result])
  @@index([createdAt])
}

// ===========================================
// TAG - Labels for contacts (many-to-many via ContactTag)
// ===========================================
model Tag {
  id         String       @id @default(cuid())
  businessId String
  name       String
  color      String?      @default("#6B7280")
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts   ContactTag[]

  @@unique([businessId, name])
  @@index([businessId])
}

// ===========================================
// CONTACT TAG - Join table for Contact <-> Tag many-to-many
// ===========================================
model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
}

// ===========================================
// JOB - Services performed / to be performed for a contact
// ===========================================
model Job {
  id            String    @id @default(cuid())
  businessId    String
  contactId     String
  serviceName   String
  description   String?   @db.Text
  scheduledDate DateTime?
  completedDate DateTime?
  amount        Float?
  status        String    @default("scheduled") // scheduled, in_progress, completed, cancelled, invoiced
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([contactId])
  @@index([status])
}

// ===========================================
// EMAIL CAMPAIGN - Bulk email sends to contacts
// ===========================================
model EmailCampaign {
  id             String           @id @default(cuid())
  businessId     String
  senderName     String           @default("Align and Acquire")
  subject        String
  body           String           @db.Text
  images         Json? // [{ url: "https://...", filename: "logo.png", order: 0 }]
  status         String           @default("draft") // draft, sending, sent, failed
  recipientCount Int              @default(0)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients     EmailRecipient[]

  @@index([businessId])
  @@index([status])
}

// ===========================================
// EMAIL RECIPIENT - Per-contact delivery status for a campaign
// ===========================================
model EmailRecipient {
  id         String        @id @default(cuid())
  campaignId String
  contactId  String
  email      String
  status     String        @default("pending") // pending, sent, delivered, bounced, failed
  sentAt     DateTime?
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
}

// ===========================================
// ACTIVITY - Timeline of interactions with a contact
// ===========================================
model Activity {
  id          String   @id @default(cuid())
  businessId  String
  contactId   String
  type        String // missed_call, sms_conversation, voicemail, website_form, email_sent, job_created, job_completed, note_added, status_changed
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([contactId])
  @@index([createdAt])
}

// ===========================================
// WEBSITE LEAD - Contact form submissions from business websites
// ===========================================
model WebsiteLead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  email   String?
  message String? @db.Text

  status String @default("new") // new, contacted, converted, closed

  // A/B arm this lead came from: "gate" | "nogate" | null for pre-test rows.
  variant String?

  // Funnel VIDEO A/B: "A" | "B". Deliberately a separate column from `variant`
  // above, which holds the retired gate/nogate arm and feeds
  // /api/admin/funnel-variants. Reusing it would corrupt that report.
  funnelVariant String?

  // Unguessable token for the "here is your demo" SMS link. Lets the lead come
  // back to their unlocked video later. Random rather than the cuid id, because
  // following this link identifies the visitor AS this lead and prefills their
  // name and phone into the booking form.
  resumeToken String? @unique

  // Set once, when the lead-facing demo SMS actually dispatches. Guarantees the
  // text is never sent twice for the same lead.
  demoSmsSentAt DateTime?

  // Stamped when the owner alert for this lead is claimed. Deliberately a
  // re-notify window, not a once-ever flag like demoSmsSentAt above: a prospect
  // coming back days later is a real buying signal and the owner should hear
  // about it, while a refresh or a double submit must not send twice. See
  // OWNER_RENOTIFY_AFTER_MS in app/api/demo-lead/wizard/route.ts.
  ownerNotifiedAt DateTime?

  /// Stamped when the 24h "still no booking" follow-up text is claimed.
  /// Claimed the same conditional-update way as demoSmsSentAt, so overlapping
  /// cron runs cannot double-text.
  followUpSentAt DateTime?

  /// Random 16-character token embedded in every /calendar link we text this
  /// lead. Verified by lookup, not by signature: the row IS the proof, which
  /// keeps the link short enough to leave the text at two SMS segments instead
  /// of three. Unique so a collision surfaces as a write error rather than
  /// silently pointing two leads at one row. Clearing it revokes the link.
  calendarToken String? @unique

  /// When this lead's phone passed OTP. The follow-up cron keys on THIS, not on
  /// createdAt and not on demoSmsSentAt: a row can exist before verification,
  /// and keying on anything looser risks texting someone who never proved they
  /// hold the number.
  otpVerifiedAt DateTime?

  /// Ad attribution, first and last touch. JSON rather than a column per field
  /// because they are read as a pair and displayed, never filtered on: nine
  /// columns times two touches would be eighteen nullable columns nobody
  /// queries. Shape is AttributionTouch in lib/attribution.ts.
  ///
  /// firstTouch is written ONCE, on the first visit carrying any signal, and is
  /// never overwritten — that is the whole point of keeping both.
  attributionFirst Json?
  attributionLast  Json?

  /// _fbp / _fbc as they were on the browser at OTP. Stored because CAPI match
  /// quality collapses without them and the cookies are gone by the time
  /// anyone looks at the row. _fbc is derived from fbclid when Meta's own
  /// cookie is missing (see buildFbc).
  fbp String?
  fbc String?

  /// Which calendar the booking came off: "landing" | "watch" | "calendar".
  /// Stamped on the lead as well as the appointment so the lead list can answer
  /// "did they book before or after the video" without a join.
  bookingSurface String?

  // Spam scoring (see lib/spam-score.ts). All nullable and additive: null means
  // the row predates scoring, which is why spamScore is not defaulted to 0.
  // A high score sets status='spam' and suppresses owner notification — it NEVER
  // prevents the row being written.
  spamScore   Int?
  spamReasons Json? // string[] of SpamReason codes
  sourceIp    String?
  userAgent   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
  @@index([variant])
}

// ===========================================
// REVIEW REQUEST - One review-request SMS per billing event
// ===========================================
model ReviewRequest {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: deleting a contact must not erase the send history.
  // That row is the audit trail when a customer asks why they were texted.
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customerPhone String // E.164 at write
  customerName  String?

  source             String // quickbooks, zapier, square, manual
  externalInvoiceId  String
  externalCustomerId String?

  status     String  @default("queued") // queued, sending, sent, skipped, failed
  skipReason String? // opted_out, frequency_cap, no_phone, invalid_phone, no_review_link, feature_disabled, duplicate, expired, send_failed

  scheduledFor DateTime?
  sentAt       DateTime?

  telnyxSid    String?
  telnyxStatus String?
  messageBody  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-invoice dedupe: the same billing event can never queue twice.
  @@unique([businessId, source, externalInvoiceId])
  // businessId-leading, so it also serves businessId-only lookups.
  @@index([businessId, createdAt])
  // Deliberately NOT tenant-prefixed: this is the cron's cross-tenant drain query.
  @@index([status, scheduledFor])
  // Powers the per-customer frequency cap (reviewCapDays).
  @@index([businessId, customerPhone, sentAt])
  @@index([contactId])
}

// ===========================================
// GOOGLE ADS SNAPSHOT - Daily campaign metrics from Google Ads
// ===========================================
model GoogleAdsSnapshot {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date              DateTime // The reporting date (start of day)
  campaignId        String // Google Ads campaign ID
  campaignName      String // Campaign name at time of sync
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  cost              Float    @default(0) // USD (converted from cost_micros / 1_000_000)
  conversions       Float    @default(0)
  ctr               Float    @default(0) // Click-through rate (0.0–1.0)
  costPerConversion Float? // cost / conversions (null if 0 conversions)

  createdAt DateTime @default(now())

  @@unique([businessId, campaignId, date])
  @@index([businessId, date])
}

// ===========================================
// COUPON CLAIM — $200 off the setup fee, 24h to book
// ===========================================
// Server-authoritative. The countdown on the page reads expiresAt from here, so
// refreshing, clearing storage, or revisiting cannot reset it, and an expired
// claim stays expired. No evergreen timers.
model CouponClaim {
  id String @id @default(cuid())

  code      String  @unique // shown to the visitor and quoted in the confirmation
  visitorId String // opaque id from the httpOnly visitor cookie
  leadId    String? // bound once the visitor becomes a lead
  variant   String? // which A/B arm claimed it

  claimedAt     DateTime  @default(now())
  expiresAt     DateTime // claimedAt + 24h
  redeemedAt    DateTime? // set when a booking actually used it
  appointmentId String?

  @@index([visitorId])
  @@index([leadId])
  @@index([expiresAt])
}

// ===========================================
// FUNNEL EVENT — per-screen gate analytics
// ===========================================
// The site has no analytics store of its own, only the Meta pixel, and pixel
// custom events cannot be queried from here. Drop-off per gate screen is the
// whole point of the step wizard, so it is recorded first-party too.
//
// Deliberately thin: no PII, just which screen was completed, by which visitor,
// in which arm. Join to WebsiteLead on visitorId when you need the person.
/// One row per OTP SEND. Not one per phone, and not one per session: making
/// every send a row is what makes the fraud caps countable with a plain query
/// instead of in-memory state, which on Vercel is per-lambda and therefore
/// useless as a real limit (see lib/rate-limit.ts).
///
/// The code is never stored in the clear. verifiedAt turns a row into a
/// single-use ticket that the lead-write routes redeem.
model PhoneVerification {
  id String @id @default(cuid())

  phone    String // E.164, always +1XXXXXXXXXX
  codeHash String // sha256(code + phone + pepper). Never the code itself.

  expiresAt  DateTime
  attempts   Int       @default(0) // verify attempts against THIS row, max 3
  verifiedAt DateTime?
  consumedAt DateTime? // set when a lead redeems it, so a ticket works once

  visitorId     String?
  variant       String?
  funnelVariant String?
  ip            String?

  /// Telnyx message id for the code text. Stored so delivery can be resolved
  /// by id later; before this it was only written to the console, which meant
  /// "did the code actually arrive" could only be answered by matching phone
  /// and timestamp against the detail records.
  providerMessageId String?

  /// Last known Telnyx delivery status: delivered | failed | sending | ...
  /// and the bare error code when it failed (40001 is a landline). Filled by
  /// scripts/sync-otp-delivery.ts, never on the send path — a delivery receipt
  /// arrives seconds to minutes after the send returns.
  deliveryStatus String?
  deliveryError  String?

  createdAt DateTime @default(now())

  // Per-phone send caps and "find the active code for this number".
  @@index([phone, createdAt])
  // Per-IP send cap.
  @@index([ip, createdAt])
  // Global daily cap. Deliberately not tenant- or phone-prefixed: the query it
  // serves counts every send platform-wide.
  @@index([createdAt])
}

/// Arm attribution ledger for /book.
///
/// Deliberately separate from FunnelEvent, which is PII-free per-screen
/// analytics. This table exists to answer one question — "how does each arm
/// convert?" — and to do it needs the identifying fields FunnelEvent must not
/// hold. Two row types only:
///
///   view           a gate page load, one per ViewContent
///   verified_lead  an OTP-verified lead, written at the same moment the Lead
///                  event fires, so the two can never disagree
///
/// The rate in /admin/arms is verified_lead / view per arm.
model ArmEvent {
  id String @id @default(cuid())

  type String // "view" | "verified_lead"
  arm  String // A | B | C, or "unassigned" when the cookie was missing

  // Null on view rows. Populated on verified_lead rows.
  trade        String?
  businessName String?
  phone        String? // E.164

  visitorId String?
  leadId    String?

  /// Which video the visitor was actually served on this watch_view. Recorded
  /// per row rather than read from env at report time: the env var can change
  /// between the view and the report, and an A/B test whose arms cannot be
  /// tied to the file that played is not a test.
  videoUrl String?

  createdAt DateTime @default(now())

  // Serves the per-arm rollups and the 7-day window in one index.
  @@index([arm, type, createdAt])
  @@index([createdAt])
}

model FunnelEvent {
  id String @id @default(cuid())

  name          String // e.g. "gate_step_completed"
  step          String? // screen name: trade | phone | firstName | ...
  visitorId     String?
  variant       String? // gate | nogate
  funnelVariant String? // A | B
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([visitorId])
  @@index([funnelVariant])
}
